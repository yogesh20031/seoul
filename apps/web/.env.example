# SeoulMate web environment. Copy to `.env.local` for local dev; in production set these on Vercel
# (Project → Settings → Environment Variables). Never commit real values.
#
# Every variable the web app reads, in one place (details below each one):
#
#   Variable              Required  Where it is read                               Local value
#   API_URL               no        src/lib/api.ts (falls back to localhost:4000)  http://localhost:4000
#   NEXT_PUBLIC_SITE_URL  no        src/app/[locale]/layout.tsx (metadataBase)     http://localhost:3000
#   NODE_ENV              never set by hand; Next sets it (src/lib/session.ts uses it for the secure cookie flag)
#
# The web app has no database, Stripe or JWT settings: it only talks to the API, which owns those
# (see apps/api/.env.example).

# Where the Express API lives. Server-side only: the browser never talks to the API directly,
# so this is not NEXT_PUBLIC_. Production: your Render URL, e.g. "https://seoul-api.onrender.com"
API_URL="http://localhost:4000"

# Public URL of this site, used for metadata and share links.
# Production: your Vercel URL, e.g. "https://seoul.vercel.app"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NODE_ENV is set by Next itself (development for `next dev`, production for builds); don't set it here.
