{
  "name": "@seoul/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed:guides": "tsx --env-file-if-exists=.env prisma/seed-guides.ts",
    "db:seed:unrated": "tsx --env-file-if-exists=.env prisma/seed-unrated.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@seoul/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "nanoid": "5.1.16",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "stripe": "23.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
