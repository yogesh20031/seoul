# SeoulMate API environment. Copy to `.env` for local dev; in production set these on Render.
# Never commit real values: `.env` is git-ignored, this example file is not.

# --- Runtime -----------------------------------------------------------------
# development | test | production. Render sets production via render.yaml.
NODE_ENV="development"
# Render injects its own PORT; 4000 is only the local default.
PORT=4000

# --- Database (Postgres) -----------------------------------------------------
# Local: `pnpm --filter @seoul/api db:dev` starts an embedded Postgres on 5433 with these credentials.
# Production (Neon, free): Dashboard → your project → Connect.
#   DATABASE_URL = the *pooled* connection string (host contains "-pooler"), with ?sslmode=require
#   DIRECT_URL   = the *direct* (non-pooled) string; Prisma migrations need it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/seoul"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/seoul"

# --- Auth --------------------------------------------------------------------
# At least 32 random characters. Local: `openssl rand -base64 48`. Render generates one for you.
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- CORS / redirects --------------------------------------------------------
# Comma-separated browser origins allowed to call the API. The first one is also where
# Stripe sends people back after checkout, so put the main site first.
# Production: your Vercel URL, e.g. "https://seoul.vercel.app"
WEB_URL="http://localhost:3000"

# --- Payments (Stripe, TEST MODE ONLY) ---------------------------------------
# "mock" marks bookings paid instantly with no Stripe (dev only; refused in production).
# "stripe" uses Stripe Checkout in test mode and needs both keys below.
PAYMENTS_MODE="mock"
# Stripe Dashboard (Test mode on) → Developers → API keys → Secret key. Must start with sk_test_.
STRIPE_SECRET_KEY=""
# Stripe Dashboard → Developers → Webhooks → add endpoint
#   https://<your-render-service>.onrender.com/api/v1/webhooks/stripe  (event: checkout.session.completed)
# then copy its "Signing secret" (whsec_...). Locally: `stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=""

# --- Seeding -----------------------------------------------------------------
# The seed wipes all data, so it refuses to run with NODE_ENV=production unless this is "1".
# Set it only for the one-off first seed of the production database, then remove it.
SEED_FORCE=""
